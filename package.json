{
  "name": "dsh-cost-insights",
  "version": "1.0.1",
  "private": true,
  "description": "Auditable usage, cost, token, cache, balance and pricing analytics for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Cost Insights / 用量与费用分析",
    "summary": "按会话、工作区、模型、Provider 与任意日期范围查看费用、Token、缓存、余额和价格来源。",
    "categories": [
      "用量",
      "费用",
      "Web UI",
      "观测"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:usage-insights"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.7 <0.2.0",
      "node": "^22.19.0 || >=24.0.0"
    },
    "permissions": {
      "network": [
        "https://api.deepseek.com",
        "https://api-docs.deepseek.com",
        "https://openrouter.ai",
        "https://developers.openai.com",
        "https://ai.google.dev",
        "https://platform.claude.com",
        "https://api.moonshot.cn",
        "https://api.siliconflow.cn",
        "https://data-api.ecb.europa.eu"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.8",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.7 <0.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elviass/dsh-cost-insights.git"
  },
  "homepage": "https://github.com/elviass/dsh-cost-insights#readme",
  "bugs": {
    "url": "https://github.com/elviass/dsh-cost-insights/issues"
  },
  "scripts": {
    "check": "node scripts/check-release.mjs && node --check lib/index.js && node --check lib/store.js && node --check lib/pricing.js && node --check lib/providers.js && node --check lib/validation.js && node --check lib/typert.host.js && node --check lib/client.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "test:ui": "node test/ui-smoke.cjs",
    "test:live": "node scripts/live-sync-smoke.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cost",
    "usage",
    "tokens",
    "cache",
    "balance"
  ]
}
